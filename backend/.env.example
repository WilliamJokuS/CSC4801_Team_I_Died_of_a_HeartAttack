# Copy to backend/.env for local runs. Placeholders only — never commit .env.
# Keep in sync with the root .env.example.
DATABASE_URL=postgres://app:app@localhost:5432/recruiting
TEST_DATABASE_URL=postgres://app:app@localhost:5432/recruiting_test
# Must be at least 32 characters; the server refuses to start with this placeholder. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=24h
PORT=8080
