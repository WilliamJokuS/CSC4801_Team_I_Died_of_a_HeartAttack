# Copy this file to .env and fill in local values. Never commit .env.
# See INSTALL.md for the full setup walkthrough.

# Main database (PostgreSQL via Prisma)
DATABASE_URL=postgres://app:app@localhost:5432/recruiting

# Isolated database used only by the test suite — never point this at the main database
TEST_DATABASE_URL=postgres://app:app@localhost:5432/recruiting_test

# Signs and verifies JWTs. Use a long random value locally; never reuse a real secret here.
JWT_SECRET=change-me

# Token lifetime (see Contract/API_Contract.md "Resolved decisions")
JWT_EXPIRES_IN=24h

# Backend server port
PORT=8080
